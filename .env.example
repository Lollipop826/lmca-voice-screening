# ========================================
# LLM API 配置
# ========================================

# SiliconFlow配置（推荐，国内访问快）
SILICONFLOW_API_KEY=your-api-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# 阿里云百炼（实时陪伴默认优先使用；兼容 OpenAI Chat API）
# 本地 Memobase 也使用此 Key 调用 qwen-plus 与 text-embedding-v4。
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen3.7-flash
DASHSCOPE_CONSOLIDATION_MODEL=qwen-plus

# OpenAI配置（备选）
# OPENAI_API_KEY=your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# ========================================
# Hugging Face 镜像配置
# ========================================
HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# ========================================
# RAG Fusion 配置（新增）
# ========================================

# 是否启用RAG Fusion（true/false）
ENABLE_RAG_FUSION=true

# 生成查询数量（3-10，推荐5）
# 越多召回越全，但越慢
RAG_FUSION_NUM_QUERIES=5

# 每个查询召回文档数（5-10，推荐8）
RAG_FUSION_DOCS_PER_QUERY=8

# 是否启用精排（true/false）
# 启用会更准确但更慢
RAG_FUSION_ENABLE_RERANKING=false

# ========================================
# Agent 配置
# ========================================

# 使用哪个Agent（0=Standard, 1=Fast）
USE_FAST_AGENT=1

# ========================================
# 火山引擎豆包语音 API 配置（替换本地 ASR/TTS）
# ========================================

# 豆包语音 APP ID（控制台 > 豆包语音 > 应用管理，纯数字格式）
VOLC_APP_ID=your-app-id-here

# 豆包语音 Access Token（控制台获取，UUID 格式）
VOLC_ACCESS_TOKEN=your-access-token-here

# TTS 音色（默认温柔女声，可在豆包语音音色库选择）
VOLC_TTS_VOICE=zh_female_vv_uranus_bigtts
# 已训练成功的豆包真人音色 SpeakerID；填写后自动使用 seed-icl-2.0
VOLC_TTS_SPEAKER_ID=

# TTS 资源ID（当前豆包语音合成模型 2.0）
VOLC_TTS_RESOURCE=seed-tts-2.0

# ASR API 资源ID（API资源，不是控制台实例名称）
ARK_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# ASR 请求模式：当前资源的整段转写使用 bigmodel_nostream。
# bigmodel_async 仅返回异步任务 ID；实现结果轮询前不能用于实时陪伴。
ARK_ASR_MODE=bigmodel_nostream
# 新版鉴权可直接使用 API Key；未配置时使用下面的 APP ID + Access Token。
# VOLC_API_KEY=your-api-key-here

# 火山语音 WebSocket 的代理策略。留空/direct=忽略 HTTPS_PROXY、ALL_PROXY
# 直连（默认）；system=沿用环境变量；也可直接填一个代理地址。
# 火山是国内端点，走境外代理只会白加握手开销：本机实测同一条 BigASR 流
# 走代理建连 1.51s，物理网卡 0.10s。
# 注意这只管环境变量这一层。Clash 的 TUN（tun.enable + auto-route）在 IP
# 路由层截流，本进程看不见也绕不开，需要另外改代理规则或路由。
VOLC_WS_PROXY=

# 是否启用火山引擎 ASR API（true=云端，false=本地SenseVoice）
USE_ARK_ASR=false

# 是否启用火山引擎 TTS API（true=云端，false=本地ZipVoice）
USE_ARK_TTS=false

# ========================================
# 其他配置
# ========================================

# SoulX-Duplug 作为 8502 的语义轮次判断与全双工打断模块。
# 需要先启动 SoulX 的 server.py（默认 ws://127.0.0.1:8000/turn）。
USE_SOULX_TURN_TAKING=true
SOULX_TURN_URL=ws://127.0.0.1:8000/turn
SOULX_TIMEOUT_S=3.0
SOULX_RETRY_INTERVAL_S=5.0
SOULX_MIN_UTTERANCE_RMS=0.008
# AI 说话时，多低能量的 nonidle 不算打断（单个 160ms chunk 的 RMS）。
# 0 = 不设闸，保持历史行为。用于挡掉扬声器回声/环境噪声导致的误打断，
# 判据取自 SoulX 随状态返回的 chunk_rms，不引入额外打断延迟。
# 调高前请先按现场实测标定：定太高会让真实打断失灵。
SOULX_BARGE_IN_MIN_CHUNK_RMS=0
# 普通语音输入连续静音多久才算一轮结束，单位：秒
VAD_END_SILENCE_S=1.2
ENABLE_FULL_DUPLEX=true
# SoulX 不可用时，本地 VAD 确认持续人声后先停播，整句识别在停播之后进行。
# 仍保留 VAD 概率、音量、连续帧和已启用的声纹验证，不把单个噪声峰当打断。
FULL_DUPLEX_STOP_DURATION=0.20

# 心理健康主线发布开关
DEFAULT_SESSION_MODE=wellbeing
ENABLE_COGNITIVE_SCREENING=true
ENABLE_TURN_INSIGHT=true
ENABLE_PATIENT_MEMORY_DELETE=true
ENABLE_DEMO_DATA=false

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# ========================================
# 对外 REST API（/v1）
# ========================================
# 逗号分隔的调用方 API Key。未配置时服务会在 data/.public_api_key
# 自动生成一个 bootstrap Key（仅当前系统用户可读）。生产环境建议显式配置多个 Key，
# 便于按调用方轮换和撤销。
# PUBLIC_API_KEYS=adsk_key_for_client_a,adsk_key_for_client_b
PUBLIC_API_RATE_LIMIT_PER_MINUTE=60

# 声纹验证：ERes2NetV2 中文 20 万说话人模型；可设为 resnet34 快速回退。
SPEAKER_VERIFIER_MODEL=eres2netv2
SPEAKER_VERIFIER_THRESHOLD=0.36
SPEAKER_VERIFIER_CPU_THREADS=4
PUBLIC_API_SESSION_TTL_SECONDS=3600

# 长程记忆：正式模式由 SQLite 保存完整档案；仅允许连接本机 Memobase。
# 正式系统保持 true；仅在对话耗时 A/B 实验的无记忆组中临时设为 false。
ENABLE_LONG_TERM_MEMORY=true
# 正式环境保持 true；仅性能实验冻结记忆库时临时设为 false。
ENABLE_LONG_TERM_MEMORY_WRITES=true
# 宿主机运行服务时使用此地址。
MEMOBASE_PROJECT_URL=http://127.0.0.1:8019
MEMOBASE_API_KEY=secret
# 语音正式回复最多额外等待远程检索 250ms；超时保持现有本地上下文。
MEMORY_RETRIEVAL_TIMEOUT_S=0.25
# 元数据/检索 HTTP 的短预算，独立于后台镜像写入的长超时。
MEMORY_RETRIEVAL_HTTP_TIMEOUT_S=1.5
# 分用户、查询和本地记忆版本的有界缓存；TTL=0 可关闭结果缓存。
MEMORY_RETRIEVAL_CACHE_TTL_S=60
MEMORY_RETRIEVAL_CACHE_MAX_ENTRIES=128
MEMORY_RETRIEVAL_MAX_INFLIGHT=2
# ASR 稳定 350ms 后预取；预取间隔至少 500ms，同轮仅保留一个预取任务。
MEMORY_PREFETCH_STABILITY_S=0.35
MEMORY_PREFETCH_MIN_INTERVAL_S=0.5
# 下列变量与 vendor/memobase/src/server/docker-compose.yml 对齐。
# 生产或局域网环境请替换默认密码，并保持 ACCESS_TOKEN 与 MEMOBASE_API_KEY 相同。
DATABASE_NAME=memobase
DATABASE_USER=memobase
DATABASE_PASSWORD=helloworld
DATABASE_LOCATION=./data/memobase/postgres
REDIS_PASSWORD=helloworld
REDIS_LOCATION=./data/memobase/redis
DATABASE_EXPORT_PORT=15432
REDIS_EXPORT_PORT=16379
API_EXPORT_PORT=8019
API_HOSTS=http://127.0.0.1:8019,http://localhost:8019
USE_CORS=false
PROJECT_ID=memobase_dev
ACCESS_TOKEN=secret
EMOTION_USE_TRANSFORMERS=false
EMOTION_MODEL_NAME=uer/roberta-base-finetuned-dianping-chinese
# Optional Emotion2Vec+ voice inference. Keep false for text-only fallback.
USE_MODELSCOPE=false
EMOTION_USE_GPU=false
EMOTION2VEC_MODEL=iic/emotion2vec_plus_large
# Keep model cache off C: when enabling the optional model.
# MODELSCOPE_CACHE=E:/PROJECT/Emotions/lmca-share/data/modelscope
PUBLIC_API_MAX_SESSIONS=100

# ========================================
# 上下文方案 A/B 测试（可选）
# ========================================
# 不配置时只启用 baseline，现有 API 行为完全不变。
# 候选服务只接收约定的对话/状态 JSON，不需要获得本项目源码。
# CONTEXT_PROVIDER_URL=http://context-service:8080/v1/context/build
# CONTEXT_PROVIDER_VARIANT=candidate-v1
# CONTEXT_PROVIDER_API_KEY=replace-with-a-private-service-key
# CONTEXT_PROVIDER_TIMEOUT_SECONDS=1.5
# CONTEXT_PROVIDER_MAX_RECENT_MESSAGES=12
# CONTEXT_PROVIDER_FAILURE_THRESHOLD=3
# CONTEXT_PROVIDER_COOLDOWN_SECONDS=30
# CONTEXT_PROVIDER_DEFAULT_VARIANT=baseline

# 同时运行多个候选版本时使用 JSON；密钥建议通过 api_key_env 引用单独的环境变量。
# CONTEXT_CANDIDATE_V2_KEY=replace-me
# CONTEXT_PROVIDER_VARIANTS_JSON={"candidate-v1":{"url":"http://context-v1:8080/v1/context/build","api_key_env":"CONTEXT_PROVIDER_API_KEY"},"candidate-v2":{"url":"http://context-v2:8080/v1/context/build","api_key_env":"CONTEXT_CANDIDATE_V2_KEY","timeout_seconds":1.5}}
